# Houdini scenes and assets go to Git LFS. "lockable" makes them read-only until you run
# `git lfs lock <file>`, so two people cannot edit the same file (they cannot be merged).
*.hip    filter=lfs diff=lfs merge=lfs -text lockable
*.hiplc  filter=lfs diff=lfs merge=lfs -text lockable
*.hipnc  filter=lfs diff=lfs merge=lfs -text lockable
*.hda    filter=lfs diff=lfs merge=lfs -text lockable
*.hdalc  filter=lfs diff=lfs merge=lfs -text lockable
*.hdanc  filter=lfs diff=lfs merge=lfs -text lockable

# Large binary data: Git LFS
*.bgeo.sc filter=lfs diff=lfs merge=lfs -text
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text

# Text: same line endings on every computer
*.py   text eol=lf
*.vex  text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.dxf  text eol=lf
*.json text eol=lf
*.toml text eol=lf
